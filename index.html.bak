<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no" />
  <meta name="theme-color" content="#000000" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Calculator" />
  <link rel="manifest" href="manifest.webmanifest" />
  <link rel="apple-touch-icon" href="icon-180.png" />
  <link rel="icon" href="icon-192.png" />
  <link rel="stylesheet" href="style.css" />
  <title>Calculator</title>
</head>
<body>
  <main class="calculator" id="calculator" aria-label="Calculator">
    <section class="top-controls" aria-label="Calculator controls">
      <button class="round-control" id="modeButton" type="button" aria-label="Calculator modes">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <rect x="14" y="7" width="36" height="50" rx="6.5" fill="none" stroke="currentColor" stroke-width="4"/>
          <rect x="20" y="13" width="24" height="10" rx="2.5" fill="currentColor"/>
          <circle cx="22" cy="31" r="3" fill="currentColor"/><circle cx="32" cy="31" r="3" fill="currentColor"/><circle cx="42" cy="31" r="3" fill="currentColor"/>
          <circle cx="22" cy="40" r="3" fill="currentColor"/><circle cx="32" cy="40" r="3" fill="currentColor"/><circle cx="42" cy="40" r="3" fill="currentColor"/>
          <circle cx="22" cy="49" r="3" fill="currentColor"/><circle cx="32" cy="49" r="3" fill="currentColor"/><circle cx="42" cy="49" r="3" fill="currentColor"/>
        </svg>
      </button>

      <button class="round-control" id="historyButton" type="button" aria-label="History">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <circle cx="32" cy="32" r="21" fill="none" stroke="currentColor" stroke-width="4"/>
          <path d="M32 18v15H21" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </section>

    <section class="display-wrap" aria-live="polite">
      <div class="display-stack" id="displayStack">
        <div class="expression-line" id="expressionLine"></div>
        <div class="display" id="display">0</div>
      </div>
    </section>

    <section class="keypad" id="keypad" aria-label="Calculator keypad">
      <button class="key key-function key-backspace" type="button" data-action="backspace" aria-label="Backspace">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <path d="M28 14h25a5 5 0 0 1 5 5v26a5 5 0 0 1-5 5H28L8 32 28 14Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/>
          <path d="M34 24 47 40M47 24 34 40" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
        </svg>
      </button>
      <button class="key key-function" id="clearButton" type="button" data-action="clear">AC</button>
      <button class="key key-function" type="button" data-action="percent">%</button>
      <button class="key key-operator" type="button" data-operator="/">÷</button>

      <button class="key key-number" type="button" data-digit="7">7</button>
      <button class="key key-number" type="button" data-digit="8">8</button>
      <button class="key key-number" type="button" data-digit="9">9</button>
      <button class="key key-operator" type="button" data-operator="*">×</button>

      <button class="key key-number" type="button" data-digit="4">4</button>
      <button class="key key-number" type="button" data-digit="5">5</button>
      <button class="key key-number" type="button" data-digit="6">6</button>
      <button class="key key-operator" type="button" data-operator="-">−</button>

      <button class="key key-number" type="button" data-digit="1">1</button>
      <button class="key key-number" type="button" data-digit="2">2</button>
      <button class="key key-number" type="button" data-digit="3">3</button>
      <button class="key key-operator" type="button" data-operator="+">+</button>

      <button class="key key-number key-sign" type="button" data-action="sign" aria-label="Toggle sign">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <path d="M17 14v18M8 23h18M39 47h18M23 54 45 10" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
        </svg>
      </button>
      <button class="key key-number" type="button" data-digit="0">0</button>
      <button class="key key-number key-decimal" type="button" data-action="decimal">.</button>
      <button class="key key-operator" type="button" data-action="equals">=</button>
    </section>
  </main>

  <dialog class="sheet" id="modeSheet">
    <div class="sheet-card compact-sheet">
      <h2>Calculator</h2>
      <button type="button" class="sheet-row selected"><span>Basic</span><span>✓</span></button>
      <button type="button" class="sheet-row" disabled><span>Scientific</span><span class="muted">Portrait unavailable</span></button>
      <button type="button" class="sheet-close" data-close-dialog>Done</button>
    </div>
  </dialog>

  <dialog class="sheet" id="historySheet">
    <div class="sheet-card compact-sheet">
      <h2>History</h2>
      <p class="empty-history">No Recent Calculations</p>
      <button type="button" class="sheet-close" data-close-dialog>Done</button>
    </div>
  </dialog>

  <dialog class="sheet settings-sheet" id="settingsSheet">
    <form class="sheet-card settings-card" id="settingsForm" method="dialog">
      <div class="settings-header">
        <div>
          <h2>Performance Setup</h2>
          <p>Hidden setup. Long-press AC/C to return here.</p>
        </div>
        <button type="button" class="text-button" id="settingsCancel">Close</button>
      </div>

      <label class="setting-row">
        <span>
          <strong>Force method</strong>
          <small>Result Force is safest while the third participant watches the screen.</small>
        </span>
        <select id="forceMethod">
          <option value="result">Result Force</option>
          <option value="complement">Complement Force</option>
        </select>
      </label>

      <div class="setting-row fixed-setting">
        <span>
          <strong>Date/time format</strong>
          <small>Fixed reveal format: day, month, 2-digit year, hour, minute.</small>
        </span>
        <strong>DDMMYYHHMM</strong>
      </div>

      <label class="setting-row">
        <span><strong>First participant digits</strong><small>Magic starts after this many digits followed by +.</small></span>
        <select id="firstDigits"><option value="6">6</option><option value="5">5</option><option value="4">4</option></select>
      </label>

      <label class="setting-row">
        <span><strong>Second participant digits</strong><small>The second + arms the third-entry stage.</small></span>
        <select id="secondDigits"><option value="6">6</option><option value="5">5</option><option value="4">4</option></select>
      </label>

      <label class="setting-row">
        <span><strong>Minute rollover safety</strong><small>Complement mode only. Near the end of a minute, aim at the next minute.</small></span>
        <select id="rolloverThreshold"><option value="never">Never</option><option value="40">At 40 seconds</option><option value="45">At 45 seconds</option><option value="50">At 50 seconds</option><option value="55">At 55 seconds</option></select>
      </label>

      <div class="method-help" id="methodHelp"></div>
      <div class="arm-box">
        <div><strong id="armTitle">Not armed</strong><small id="armDescription">Arm it before handing the phone to the first participant.</small></div>
        <button type="button" class="arm-button" id="armButton">Arm Next Performance</button>
      </div>
      <button type="submit" class="save-button">Save & Close</button>
    </form>
  </dialog>

  <script src="app.js"></script>
</body>
</html>
